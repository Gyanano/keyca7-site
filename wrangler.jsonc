{
  // KeyCat 主站：纯静态，Workers static assets，无 Worker 脚本
  "name": "keyca7-site",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./site"
  },
  // 绑定 Custom Domain；/play/* 由 keyca7-play 的路由 Worker 接管
  "routes": [
    { "pattern": "keyca7.com", "custom_domain": true }
  ],
  "workers_dev": false
}